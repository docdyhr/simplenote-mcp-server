# simplenote-mcp-server — environment template
# Copy to .env and fill in your values. Never commit .env.
#
#   cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────────────
SIMPLENOTE_EMAIL=your_email@example.com
SIMPLENOTE_PASSWORD=your_password

# ── Cache ─────────────────────────────────────────────────────────────────────
# Set to at least your total note count to avoid silent search gaps.
# Default: 10000 (covers most users; ~2 KB/note ≈ 20 MB at the limit)
# CACHE_MAX_SIZE=10000

# Seconds between background sync cycles (default: 120)
# SYNC_INTERVAL_SECONDS=120

# ── Logging ───────────────────────────────────────────────────────────────────
# One of: DEBUG, INFO, WARNING, ERROR  (default: INFO)
# LOG_LEVEL=INFO

# ── Offline / testing ─────────────────────────────────────────────────────────
# Skip Simplenote API calls — used by the test suite and local dev without creds
# SIMPLENOTE_OFFLINE_MODE=false

# ── Advanced (rarely needed) ──────────────────────────────────────────────────
# RATE_LIMIT_REQUESTS=100      # requests per window (default: 100)
# RATE_LIMIT_WINDOW_SECONDS=900 # window size in seconds (default: 900)
# RATE_LIMIT_BURST=20          # short-burst allowance (default: 20)
# CACHE_INITIALIZATION_TIMEOUT=60  # seconds to wait for first sync (default: 60)
